#!/usr/bin/env bash
# Thin wrapper so the skill can call `labmate` instead of `python -m labmate`.
# Installed to /usr/local/bin/labmate inside the sandbox by scripts/deploy-to-sandbox.sh.
set -euo pipefail
export LABMATE_HOME="${LABMATE_HOME:-/sandbox/workspace/labmate-app}"
# vendor/ holds pip packages (pandas) that cannot go into the read-only Hermes venv
export PYTHONPATH="${PYTHONPATH:-}:${LABMATE_HOME}:${LABMATE_HOME}/vendor"
# A read-only host mount at /sandbox/projects wins over uploaded copies; the
# agent's own state then goes to a writable tree.
if [ -z "${LABMATE_PROJECTS_ROOT:-}" ]; then
  if [ -d /sandbox/projects ]; then LABMATE_PROJECTS_ROOT=/sandbox/projects; else LABMATE_PROJECTS_ROOT=/sandbox/workspace/projects; fi
fi
export LABMATE_PROJECTS_ROOT
# Agent-written state (claims, reports, meetings) goes in the Hermes state
# volume, not /sandbox/workspace: that is the container's writable layer and is
# lost on rebuild. .hermes/workspace is manifest-declared, so NemoClaw carries
# it across rebuilds and snapshots.
export LABMATE_STATE_ROOT="${LABMATE_STATE_ROOT:-/sandbox/.hermes/workspace/labmate-state}"
exec python3 -m labmate "$@"
